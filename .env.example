# ========================================================
# EdgeStream Production Environment Variables Template
# ========================================================

# SECURITY WARNING: keep the secret key used in production secret!
# Generate a new one for production (e.g., using `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
DJANGO_SECRET_KEY=your-super-secret-key-goes-here

# SECURITY WARNING: don't run with debug turned on in production!
DJANGO_DEBUG=False

# A comma-separated list of host/domain names that this site can serve.
# Example: edge-stream.local, 192.168.1.100, mydomain.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ========================================================
# HTTPS / SSL Security Settings (Only enable if using HTTPS)
# ========================================================
# Set to True if your site is available over HTTPS (e.g., behind Nginx/Caddy with SSL)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True

# TMDB API credentials (provide one; never commit real credentials)
# TMDB_API_KEY=your-v3-api-key
# TMDB_READ_ACCESS_TOKEN=your-api-read-access-token
